#!/usr/bin/env bash
# Blocks a push whose `make test` is red, so a red HEAD cannot reach a pushed
# branch unnoticed. Opt in with `make hooks`; nothing installs this on its own.
# Skip one push with `git push --no-verify`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# A freshly scaffolded project has no test target yet; let its pushes through.
if ! grep -qE '^test:' Makefile 2>/dev/null; then
  echo "pre-push: no 'test' target in the Makefile; nothing to run" >&2
  exit 0
fi
echo "pre-push: make test (skip this push with: git push --no-verify)" >&2
make test >&2
